{"t": 1784298316.171, "run_id": "fc_sphinx_global_s1_20260717_071258", "kind": "swe_task", "tag": "frozenmem", "idx": 12, "instance": "sphinx-doc__sphinx-9698", "scope": "repo:sphinx-doc/sphinx", "nc": 1, "n": 1, "exit_statuses": ["Submitted"], "judge": [{"success": true, "verified": true, "reason": "The patch correctly fixes the issue by removing parentheses from index entries for py:method directives with the :property: option. The fix is applied consistently across all code paths in the PyMethod.get_index_text() method, ensuring properties don't have parentheses while regular methods, classmethods, and staticmethods retain them."}], "n_retrieved": 4, "ret_scores": [0.72, 0.708, 0.706, 0.702], "mem_chars": 2724, "n_memory": 393}
