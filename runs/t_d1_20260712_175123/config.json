{
  "run": {
    "name": "t_d1",
    "seed": 0,
    "out_dir": "runs",
    "concurrency": 8,
    "budget_usd": 5.0,
    "mock": true
  },
  "llm": {
    "model": "openai/gpt-4o-mini",
    "embed_model": "openai/text-embedding-3-small",
    "temperature": 0.7,
    "max_tokens": 1024,
    "cache": true
  },
  "agent": {
    "max_steps": 15,
    "n_traj": 5
  },
  "memory": {
    "mode": "both",
    "reasoning_write": "append",
    "retrieve_k_reasoning": 2,
    "retrieve_k_fact": 4,
    "relevance_threshold": 0.0,
    "scope_reasoning": false,
    "token_budget": 4000
  },
  "m2w": {
    "protocol": "step_evolve",
    "parallelism": "task",
    "layer1": true,
    "layer2": true,
    "record_mode": "aggregate",
    "per_step_retrieval": true,
    "top_k": 5,
    "holdout": 0.5
  },
  "swe": {
    "dataset": "princeton-nlp/SWE-bench_Verified",
    "split": "test",
    "repos": "django",
    "limit": 0,
    "arch": "arm64",
    "agent_model": "openai/gpt-5-mini",
    "step_limit": 60,
    "attempt_cost_limit": 0.5,
    "arms": "nomem,withmem",
    "layer1": true,
    "layer2": true,
    "l1_max_per_task": 2,
    "vote_margin": 2,
    "judge_max_tokens": 8000
  },
  "surprise": {
    "source": "traj_divergence",
    "w_outcome_mix": 0.6,
    "w_mem_pred": 0.4,
    "threshold": 0.5
  },
  "replay": {
    "enabled": true,
    "schedule": "batch",
    "batch_size": 8,
    "priority": "surprise"
  },
  "judge": {
    "model": "openai/gpt-4o-mini"
  },
  "logging": {
    "level": "info",
    "jsonl": true,
    "trace": false
  }
}